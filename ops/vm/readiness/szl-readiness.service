[Unit]
Description=SZL readiness check 0.2.0 (fail-closed, read-only; never trains, signs or uploads)
ConditionPathExists=!/var/lib/szl-readiness/STOP

[Service]
Type=oneshot
# Confirm the account with `id -un` on the VM before install (SSH config for szl-vm1 uses User Ubuntu).
User=Ubuntu
EnvironmentFile=/etc/szl/readiness.env
StateDirectory=szl-readiness
# ${VAR} always expands to exactly one argument; an empty value becomes "" and the runner BLOCKs (exit 2,
# history line written). A missing EnvironmentFile makes the unit fail before the runner starts (journal only).
ExecStart=/usr/bin/python3 -I -B /opt/szl/readiness/szl_readiness_runner.py \
  --bundle /opt/szl/readiness --root ${SZL_ROOT} --data-root ${SZL_DATA_ROOT} --manifest ${SZL_MANIFEST} \
  --data-pins ${SZL_DATA_PINS} --evidence-base /var/lib/szl-readiness --min-disk-gb 50 --min-ram-gb 4 \
  --timeout 10800 --call-timeout 1800
# exit 1/2/3 are verdicts, not crashes: record them, do not restart
SuccessExitStatus=1 2 3
# The runner kills its own checker process group on timeout/SIGTERM; systemd's control-group kill is the backstop.
KillMode=control-group
TimeoutStartSec=3h15min
Nice=10
IOSchedulingClass=idle
NoNewPrivileges=yes
PrivateTmp=yes
ProtectSystem=strict
ProtectHome=read-only
ReadWritePaths=/var/lib/szl-readiness
IPAddressDeny=any
