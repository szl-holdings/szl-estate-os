# Copy to /etc/szl/readiness.env. Fill ONLY with paths read off the VM (ls + sha256sum).
# Left empty, the runner refuses with 'missing input' (exit 2). Never substitute a guess.
# SZL_DATA_ROOT is the directory the data-pins file names (files / eval_files keys) are relative to.
SZL_ROOT=
SZL_DATA_ROOT=
SZL_MANIFEST=
SZL_DATA_PINS=
